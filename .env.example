# Copy to .env and export, or set in your shell. All optional.

# Claude credentials: ANTHROPIC_API_KEY, or a profile from `ant auth login`.
# ANTHROPIC_API_KEY=

# auto (default): use Claude when credentials work, else offline heuristics. off | on
MAMATCH_LLM=auto
MAMATCH_CLAUDE_MODEL=claude-opus-5-5

# Shown in the header. Production deal data must be hosted in mainland China.
MAMATCH_REGION=demo-local

# MAMATCH_DATABASE_URL=sqlite:///data/mamatch.db
