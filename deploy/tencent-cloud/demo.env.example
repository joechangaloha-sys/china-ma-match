# CloudRun demo settings. Set these in the cloud console or your secret manager, never in the image.
MAMATCH_DEMO_MODE=true
MAMATCH_DEMO_ACCESS_KEY=replace-with-a-long-random-demo-passcode
MAMATCH_DEMO_ACCESS_HOURS=12
MAMATCH_SEED_DEMO=true
MAMATCH_SECURE_COOKIES=true
MAMATCH_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_PRIVATE_HOST:5432/REPLACE_DB
MAMATCH_UPLOAD_DIR=/app/data/uploads
MAMATCH_LLM=off
MAMATCH_PUBLIC_URL=
MAMATCH_FORWARDED_ALLOW_IPS=*
PORT=8080

# After Tencent assigns the default CloudRun URL, set MAMATCH_PUBLIC_URL to that HTTPS URL
# in a new revision so share links and QR codes point to the demo rather than a local address.
